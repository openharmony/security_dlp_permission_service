     bool copyable = false;
     uint32_t tokenId = 0;
     int32_t ret = DlpCredential::GetInstance().QueryDlpFileCopyableByTokenId(copyable, tokenId);
-    // Should fail with some error code (either PC_FEATURE not enabled or functiontypes check fails)
