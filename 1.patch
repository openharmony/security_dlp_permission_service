+
+using namespace OHOS::Security::DlpPermission;
+namespace OHOS {
+static void FuzzQueryDockerPolicyNeedSandbox(const uint8_t *data, size_t size)
+{
+    if (data == nullptr || size == 0) {
+        return;
+    }
+    FuzzedDataProvider provider(data, size);
+
+    // Construct URI string from fuzz data - this is the file URI input
+    std::string uri = provider.ConsumeRandomLengthString(1024);
+
+    // Construct Want object with fuzz-derived parameters
+    AAFwk::Want want;
+
+    // Set action from fuzz data
+    std::string action = provider.ConsumeRandomLengthString(256);
+    if (!action.empty()) {
+        want.SetAction(action);
+    }
+
+    // Set URI in Want from fuzz data
+    std::string wantUri = provider.ConsumeRandomLengthString(256);
+    if (!wantUri.empty()) {
+        want.SetUri(wantUri);
+    }
+
+    // Set type from fuzz data
+    std::string type = provider.ConsumeRandomLengthString(128);
+    if (!type.empty()) {
+        want.SetType(type);
+    }
+
+    // Consume remaining bytes to set optional custom flag parameter
+    // This exercises the ohos.dlp.params.customFlag path in related code
+    if (provider.remaining_bytes() >= sizeof(int32_t)) {
+        int32_t customFlag = provider.ConsumeIntegral<int32_t>();
+        want.SetParam("ohos.dlp.params.customFlag", customFlag);
+    }
+
+    // Call the target API
+    QueryDockerPolicyNeedSandbox(uri, want);
+}
+
+bool QueryDockerPolicyNeedSandboxFuzzTest(const uint8_t *data, size_t size)
+{
+    FuzzQueryDockerPolicyNeedSandbox(data, size);
+    return true;
+}
+}  // namespace OHOS
+
+/* Fuzzer entry point */
+extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
+{
+    OHOS::QueryDockerPolicyNeedSandboxFuzzTest(data, size);
+    return 0;
+}
