+
+#include "dlptransparentencpolicy_auto_fuzzer.h"
+#include <fuzzer/FuzzedDataProvider.h>
+#include <string>
+#include <vector>
+#include "dlp_file_kits.h"
+#include "dlp_permission_log.h"
+#include "securec.h"
+
+using namespace OHOS::Security::DlpPermission;
+namespace OHOS {
+namespace {
+static constexpr uint32_t METHOD_NUMBER_GROUP = 2;
+}
+
+enum class DlpTransparentEncMethodGroup {
+    GET_SANDBOX_FLAG = 0,
+    CONVERT_ABILITY_INFO = 1,
+};
+
+static void FuzzGetSandboxFlag(FuzzedDataProvider &provider)
+{
+    AAFwk::Want want;
+
+    // Construct Want with fuzz-derived action
+    // Valid actions for DLP: "ohos.want.action.viewData" or "ohos.want.action.editData"
+    // Also fuzz with arbitrary actions to test rejection paths
+    std::string action = provider.ConsumeRandomLengthString(256);
+    if (!action.empty()) {
+        want.SetAction(action);
+    }
+
+    // Construct URI string from fuzz data
+    // The URI should start with "file://" to pass the prefix check
+    std::string uri = provider.ConsumeRandomLengthString(1024);
+    if (!uri.empty()) {
+        want.SetUri(uri);
+    }
+
+    // Set customFlag parameter to exercise transparent encryption path
+    // customFlag values: 0, 37 (DLP_MANAGER_FULL_CONTROL), 38 (DLP_MANAGER_READ_ONLY)
+    if (provider.remaining_bytes() >= sizeof(int32_t)) {
+        int32_t customFlag = provider.ConsumeIntegral<int32_t>();
+        want.SetParam("ohos.dlp.params.customFlag", customFlag);
+    }
+
+    // Call the target API
+    DlpFileKits::GetSandboxFlag(want);
+}
+
+static void FuzzConvertAbilityInfoWithSupportDlp(FuzzedDataProvider &provider)
+{
+    AAFwk::Want want;
+
+    // Construct Want with fuzz-derived type (MIME type for file association)
+    std::string type = provider.ConsumeRandomLengthString(128);
+    if (!type.empty()) {
+        want.SetType(type);
+    }
+
+    // Construct URI
+    std::string uri = provider.ConsumeRandomLengthString(256);
+    if (!uri.empty()) {
+        want.SetUri(uri);
+    }
+
+    // Set action
+    std::string action = provider.ConsumeRandomLengthString(256);
+    if (!action.empty()) {
+        want.SetAction(action);
+    }
+
+    // Set customFlag to test IsTransparentEncFile branch
+    // This directly tests the new IsTransparentEncFile logic added in commit e410520
+    if (provider.remaining_bytes() >= sizeof(int32_t)) {
+        int32_t customFlag = provider.ConsumeIntegral<int32_t>();
+        want.SetParam("ohos.dlp.params.customFlag", customFlag);
+    }
+
+    // Prepare abilityInfos vector
+    std::vector<AppExecFwk::AbilityInfo> abilityInfos;
+
+    // Call the target API
+    DlpFileKits::ConvertAbilityInfoWithSupportDlp(want, abilityInfos);
+}
+
+static void FuzzDlpTransparentEncPolicy(const uint8_t *data, size_t size)
+{
+    if (data == nullptr || size == 0) {
+        return;
+    }
+    FuzzedDataProvider provider(data, size);
+
+    // Use first byte to select which method to fuzz
+    uint32_t methodIndex = provider.ConsumeIntegral<uint32_t>();
+
+    switch (methodIndex % METHOD_NUMBER_GROUP) {
+        case static_cast<uint32_t>(DlpTransparentEncMethodGroup::GET_SANDBOX_FLAG): {
+            FuzzGetSandboxFlag(provider);
+            break;
+        }
+        case static_cast<uint32_t>(DlpTransparentEncMethodGroup::CONVERT_ABILITY_INFO): {
+            FuzzConvertAbilityInfoWithSupportDlp(provider);
+            break;
+        }
+        default: {
+            break;
+        }
+    }
+}
+
+bool DlpTransparentEncPolicyFuzzTest(const uint8_t *data, size_t size)
+{
+    FuzzDlpTransparentEncPolicy(data, size);
+    return true;
+}
+}  // namespace OHOS
+
+/* Fuzzer entry point */
+extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
+{
+    OHOS::DlpTransparentEncPolicyFuzzTest(data, size);
+    return 0;
+}
